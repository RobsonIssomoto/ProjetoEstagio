@model List<ProjetoEstagio.Models.EstagiarioModel>
@{
    ViewData["Title"] = "Gestão de Estudantes";
    Layout = "_LayoutAdmin";
}

<h3 class="fw-bold">Gestão de Estudantes</h3>
<p class="text-muted">Visualize e gerencie todos os alunos cadastrados no sistema.</p>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["MensagemErro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white p-4">
        <h5 class="mb-0 fw-bold">Alunos Cadastrados</h5>
        <p class="text-muted mb-0 small">Lista completa de estudantes ativos.</p>
    </div>

    <div class="table-responsive p-3">
        <table id="estagiariosTable" class="table table-striped table-bordered table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Nome Completo</th>
                    <th class="text-start">CPF</th>
                    <th>Curso</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var aluno in Model)
                    {
                        <tr>
                            <td>@aluno.Nome</td>
                            <td class="text-start">@aluno.CPF</td>
                            <td>@aluno.NomeCurso</td>
                            <td>@aluno.Email</td>
                            <td>@(aluno.Telefone ?? "-")</td>

                            <td class="text-center">
                                <a asp-controller="Estagiario" asp-action="Editar" asp-route-id="@aluno.Id"
                                   class="btn btn-primary btn-sm" title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-controller="" asp-action="" asp-route-id="@aluno.Id"
                                   class="btn btn-danger btn-sm" title="Excluir">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Usa o mesmo getDataTable do site.js
            getDataTable('#estagiariosTable');
        });
    </script>
}