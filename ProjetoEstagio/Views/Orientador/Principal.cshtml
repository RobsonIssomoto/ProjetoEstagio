@model ProjetoEstagio.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Painel Administrativo";
    Layout = "_LayoutAdmin";
}

<div class="mb-4">
    <h3 class="fw-bold mb-0">Visão Geral</h3>
    <p class="text-muted">Bem-vindo ao painel de controle da coordenação de estágios.</p>
</div>

<div class="row g-4 mb-5">

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card text-white bg-warning h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75 small fw-bold">Aguardando Aprovação</h6>
                        <div class="h2 fw-bold mb-0">@Model.ValidacoesPendentes</div>
                    </div>
                    <i class="fa-solid fa-hourglass-half fa-2x opacity-50"></i>
                </div>
            </div>
            <a asp-action="Pendencias" class="card-footer d-flex align-items-center justify-content-between text-white text-decoration-none bg-transparent border-0">
                <span class="small fw-bold">Resolver Pendências</span>
                <i class="fa-solid fa-arrow-right small"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card text-white bg-primary h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75 small fw-bold">Estágios Ativos</h6>
                        <div class="h2 fw-bold mb-0">@Model.EstagiosAtivos</div>
                    </div>
                    <i class="fa-solid fa-briefcase fa-2x opacity-50"></i>
                </div>
            </div>
            <a asp-action="Estagios" class="card-footer d-flex align-items-center justify-content-between text-white text-decoration-none bg-transparent border-0">
                <span class="small fw-bold">Ver Histórico</span>
                <i class="fa-solid fa-arrow-right small"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card text-white bg-info h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75 small fw-bold">Estudantes</h6>
                        <div class="h2 fw-bold mb-0">@Model.TotalEstudantes</div>
                    </div>
                    <i class="fa-solid fa-user-graduate fa-2x opacity-50"></i>
                </div>
            </div>

            <a asp-controller="Orientador" asp-action="ListarEstagiarios" class="card-footer d-flex align-items-center justify-content-between text-white text-decoration-none bg-transparent border-0">
                <span class="small fw-bold">Ver Lista Completa</span>
                <i class="fa-solid fa-arrow-right small"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card text-white bg-success h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75 small fw-bold">Empresas</h6>
                        <div class="h2 fw-bold mb-0">@Model.TotalEmpresas</div>
                    </div>
                    <i class="fa-solid fa-building fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0"></div>
        </div>
    </div>
</div>

