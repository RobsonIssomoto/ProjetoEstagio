@model ProjetoEstagio.Models.UsuarioModel
@using ProjetoEstagio.Models.Enums
@using ProjetoEstagio.Helper
@inject ISessao _sessao

@{
    ViewData["Title"] = "Editar Usuário";
    Layout = "_LayoutAdmin"; // (Ou o layout que o seu Admin usa)

    // Verifica se o Admin está editando a si mesmo
    UsuarioModel usuarioLogado = _sessao.BuscarSessaoDoUsuario();
    bool editandoSiMesmo = usuarioLogado != null && usuarioLogado.Id == Model.Id;
}

<div class="container mb-4">
    <div class="row d-flex justify-content-center" style="font-size: .9em">

        <div class="col-12 col-md-8 col-lg-6 bg-white my-3 p-4 rounded shadow" style="min-width: 380px">

            <h4 class="text-center mb-4 text-uppercase fw-bold text-secondary">Dados do Usuário</h4>

            <form asp-controller="Usuario" asp-action="Alterar" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Login" class="fw-bold">Login (E-mail)</label>
                    <input type="text" class="form-control bg-light" asp-for="Login" readonly />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="fw-bold">E-mail de Contato</label>
                    <input type="email" class="form-control bg-light" asp-for="Email" readonly />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Perfil" class="fw-bold">Perfil de Acesso</label>
                    @if (editandoSiMesmo)
                    {
                        <input type="hidden" asp-for="Perfil" />
                        <input type="text" class="form-control bg-light" value="@Model.Perfil" readonly />
                        <small class="text-muted">Você não pode alterar seu próprio perfil.</small>
                    }
                    else
                    {
                        <select class="form-select" asp-for="Perfil"
                                asp-items="Html.GetEnumSelectList<Perfil>()">
                            <option value="">Selecione um perfil...</option>
                        </select>
                    }
                    <span asp-validation-for="Perfil" class="text-danger"></span>
                </div>

                <div class="row g-2 mt-4">
                    <div class="col-6">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Voltar</a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary w-100">Salvar Dados</button>
                    </div>
                </div>
            </form>

            @if (editandoSiMesmo)
            {
                <hr class="my-5 border-secondary opacity-25">

                <h4 class="text-center mb-4 text-uppercase fw-bold text-secondary">Alterar Minha Senha</h4>

                var dadosParaSenha = new ProjetoEstagio.Models.ViewModels.AlterarSenhaViewModel
                {
                    Id = Model.Id // Aqui Model.Id JÁ É o UsuarioId
                };

                <partial name="_AlterarSenha" model="dadosParaSenha" />
            }

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}