@model List<ProjetoEstagio.Models.UsuarioModel>
@{
    ViewData["Title"] = "Gestão de Administradores";
    Layout = "_LayoutAdmin";
}

<h3 class="fw-bold">Gestão de Administradores</h3>
<p class="text-muted">Gerencie os usuários com acesso total ao sistema.</p>

<div class="card shadow-sm">
    <div class="card-header bg-white p-4">
        <h5 class="mb-0 fw-bold">Administradores Cadastrados</h5>
        <p class="text-muted mb-0 small">Use o botão abaixo para conceder acesso administrativo a um novo usuário.</p>
    </div>

    <div class="d-flex justify-content-between align-items-center p-3 mb-3">
        <a href="javascript:void(0);" class="btn btn-success btn-cadastrar-admin">
            <i class="fas fa-plus-circle"></i>  Adicionar Administrador
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success mx-3" role="alert">@TempData["MensagemSucesso"]</div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger mx-3" role="alert">@TempData["MensagemErro"]</div>
    }

    <div class="table-responsive p-3">
        <table id="adminsTable" class="table table-striped table-bordered table-hover" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Login / E-mail</th>
                    <th>Data Cadastro</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var admin in Model)
                    {
                        <tr>
                            <td>@admin.Id</td>
                            <td>@admin.Login</td>
                            <td>@admin.DataCadastro.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <span class="text-muted small">Gerenciar via Perfil</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="cadastrarAdminModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Novo Administrador</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

