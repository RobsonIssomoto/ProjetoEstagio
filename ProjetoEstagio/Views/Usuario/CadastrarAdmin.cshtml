@model ProjetoEstagio.Models.ViewModels.AdminCadastroViewModel
@{
    ViewData["Title"] = "Novo Administrador";
    Layout = "_LayoutAdmin";
}

<div class="container mb-4">
    <div class="row d-flex justify-content-center" style="font-size: .9em">

        <div class="col-12 col-md-8 col-lg-6 bg-white my-3 p-4 rounded shadow" style="min-width: 380px">

            <div class="text-center mb-4">
                <h4 class="text-uppercase fw-bold text-danger mb-1">Novo Administrador</h4>
                <p class="text-muted small">Cadastre um novo usuário com perfil de gestão.</p>
            </div>

            <form asp-controller="Usuario" asp-action="CadastrarAdmin" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nome" class="fw-bold"></label>
                    <input type="text" class="form-control nome" asp-for="Nome" placeholder="Nome Completo" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CPF" class="fw-bold"></label>
                    <input type="text" class="form-control cpf" asp-for="CPF" placeholder="000.000.000-00" />
                    <span asp-validation-for="CPF" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="fw-bold"></label>
                    <input type="email" class="form-control" asp-for="Email" placeholder="email@fatec.sp.gov.br" />
                    <small class="text-muted" style="font-size: 0.8em">Este e-mail será usado como Login.</small>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Senha" class="fw-bold"></label>
                        <div class="input-icon-wrapper">
                            <input type="password" class="form-control border-end-0" asp-for="Senha" placeholder="Senha" />
                            <span class="input-icon-toggle">
                                <i class="bi bi-eye"></i>
                            </span>
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmarSenha" class="fw-bold"></label>
                        <div class="input-icon-wrapper">
                            <input type="password" class="form-control border-end-0" asp-for="ConfirmarSenha" placeholder="Confirme" />
                            <span class="input-icon-toggle">
                                <i class="bi bi-eye"></i>
                            </span>
                            <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <hr class="my-4 border-secondary opacity-25">

                <div class="row g-2 justify-content-end">
                    <div class="col-6 col-md-4">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancelar</a>
                    </div>
                    <div class="col-6 col-md-5">
                        <button type="submit" class="btn btn-danger w-100 fw-bold">
                            Cadastrar
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function(){
             $('.cpf').mask('000.000.000-00');
        });
    </script>
}